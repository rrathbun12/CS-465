<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>About - Travlr Getaways Web Template</title>
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
				{{>header}}
			</div>
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>{{aboutData.pageTitle}}</h1>
							<h2>{{aboutData.introHeading}}</h2>
							<p>{{{aboutData.introParagraphs}}}</p>
							<hr>
							<div class="ads">
								{{#each aboutData.ads}}
								<h2>{{this.heading}}</h2>
								<p>{{this.description}}</p>
								{{/each}}
							</div>
							{{#each aboutData.sections}}
							<h2>{{this.heading}}</h2>
							{{{this.description}}}
							{{/each}}
						</div>
					</div>
				</div>
			</div>
		</div>
		{{>footer}}
	</div>
</body>
</html>